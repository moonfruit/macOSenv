{
  "$schema": "https://sing-box.sagernet.org/schema.json",
  "route": {
    "rule_set": [
      {
        "type": "inline",
        "tag": "NoIPv6",
        "rules": [
          {
            "type": "logical",
            "mode": "and",
            "rules": [{ "query_type": "AAAA" }, { "default_interface_address": ["2000::/3"], "invert": true }]
          }
        ]
      },
      {
        "type": "inline",
        "tag": "GingkooDomains",
        "rules": [{ "domain_suffix": [".server.gingkoo", ".gingkoo.internal"] }]
      },
      {
        "type": "inline",
        "tag": "GingkooInside",
        "rules": [
          {
            "ip_cidr": ["10.0.0.0/8", "172.30.0.0/16", "172.32.0.0/16", "172.33.0.0/16"],
            "default_interface_address": ["10.0.0.0/8"]
          }
        ]
      },
      {
        "type": "inline",
        "tag": "GingkooOutside",
        "rules": [{ "ip_cidr": ["10.0.0.0/8", "172.30.0.0/16", "172.32.0.0/16", "172.33.0.0/16"] }]
      },
      {
        "type": "inline",
        "tag": "ExtraLan",
        "rules": [
          { "domain_suffix": [".heiyu.space", ".ts.net", ".lan", ".home.arpa", ".server.gingkoo", ".gingkoo.internal"] }
        ]
      },
      {
        "type": "inline",
        "tag": "NetworkProcess",
        "rules": [
          { "process_name": ["sing-box", "cdeplugin", "lzc-core.darwin", "openvpn", "tailscaled", "Tailscale"] }
        ]
      }
    ]
  }
}
// vim: ft=jsonc
