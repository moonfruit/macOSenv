{
  "$schema": "https://sing-box.sagernet.org/schema.json",
  "route": {
    "rule_set": [
      {
        "type": "inline",
        "tag": "NoIPv6",
        "rules": [
          {
            "type": "logical",
            "mode": "and",
            "rules": [{ "query_type": "AAAA" }, { "default_interface_address": ["2000::/3"], "invert": true }]
          }
        ]
      },
      {
        "type": "inline",
        "tag": "Home",
        "rules": [
          {
            "type": "logical",
            "mode": "and",
            "rules": [{ "domain_suffix": [".lan", ".home.arpa"] }, { "default_interface_address": ["192.168.50.0/24"] }]
          }
        ]
      },
      {
        "type": "inline",
        "tag": "PublicDNS",
        "rules": [
          { "domain": ["dns.alidns.com", "doh.pub", "dot.pub", "dns.google", "one.one.one.one", "cloudflare-dns.com"] }
        ]
      },
      {
        "type": "inline",
        "tag": "NetworkProcess",
        "rules": [
          { "process_name": ["sing-box", "cdeplugin", "lzc-core.darwin", "openvpn", "tailscaled", "Tailscale"] }
        ]
      }
    ]
  }
}
// vim: ft=jsonc
