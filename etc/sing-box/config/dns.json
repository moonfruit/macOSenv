{
  "$schema": "https://raw.githubusercontent.com/moonfruit/sing-box/refs/heads/moonfruit/docs/schema.json",
  "dns": {
    "servers": [
      // Resolver
      { "tag": "dbs-pod-udp", "type": "udp", "server": "119.29.29.29" },
      { "tag": "dns-aliyun-udp-1", "type": "udp", "server": "223.5.5.5" },
      { "tag": "dns-aliyun-udp-2", "type": "udp", "server": "223.6.6.6" },
      { "tag": "dns-resolver", "type": "group", "servers": ["dbs-pod-udp", "dns-aliyun-udp-1", "dns-aliyun-udp-2"] },
      // Direct
      { "tag": "dns-aliyun", "type": "h3", "server": "dns.alidns.com", "domain_resolver": "dns-resolver" },
      { "tag": "dns-pod", "type": "https", "server": "doh.pub", "domain_resolver": "dns-resolver" },
      { "tag": "dns-direct", "type": "group", "servers": ["dns-pod", "dns-aliyun"] },
      // Proxy
      // { "tag": "dns-google", "type": "h3", "server": "dns.google", "detour": "🔰 默认出口" },
      { "tag": "dns-one", "type": "h3", "server": "one.one.one.one", "detour": "🔰 默认出口" },
      { "tag": "dns-cloudflare", "type": "h3", "server": "cloudflare-dns.com", "detour": "🔰 默认出口" },
      { "tag": "dns-proxy", "type": "group", "servers": ["dns-one", "dns-cloudflare"] },
      // Hosts
      { "tag": "dns-hosts", "type": "hosts", "path": ["hosts", "/etc/hosts"] },
      // Local
      { "tag": "dns-local", "type": "local" },
      // Home
      { "tag": "dns-home", "type": "udp", "server": "192.168.50.1", "server_port": 1053 },
      { "tag": "dns-home-tailnet", "type": "udp", "server": "192.168.50.1", "server_port": 1053, "detour": "tailscale-ep" },
      // Gingkoo
      { "tag": "dns-gingkoo", "type": "udp", "server": "10.1.2.59" },
      // LazyCat
      { "tag": "dns-lazycat", "type": "udp", "server": "fc03:1136:3800::1" },
      // Tailscale
      { "tag": "dns-tailscale", "type": "tailscale", "endpoint": "tailscale-ep" },
      // FakeIP
      { "tag": "dns-fakeip", "type": "fakeip", "inet4_range": "22.0.0.0/8" }
    ],
    "rules": [
      // Hosts
      { "preferred_by": "dns-hosts", "server": "dns-hosts" },
      // Local
      { "preferred_by": "dns-local", "server": "dns-local" },
      // Home
      { "rule_set": "Home", "server": "dns-home" },
      { "rule_set": "NotHome", "server": "dns-home-tailnet" },
      // Tailscale
      { "preferred_by": "dns-tailscale", "server": "dns-tailscale" },
      // LazyCat
      { "domain_suffix": "heiyu.space", "server": "dns-lazycat" },
      // Lan
      { "domain_suffix": ["heiyu.space", "ts.net"], "rule_set": "Lan", "action": "predefined", "rcode": "NXDOMAIN" },
      // Gingkoo
      { "domain_suffix": ["server.gingkoo", "gingkoo.internal"], "server": "dns-gingkoo" },
      // 无 IPv6 时不解析 IPv6 地址
      { "rule_set": "NoIPv6", "action": "predefined" },
      // 公共 DNS
      { "rule_set": "PublicDNS", "server": "dns-resolver" },
      // Fake IP
      { "rule_set": "FakeIpBypass", "server": "dns-direct" },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          { "process_name": "q", "invert": true },
          { "query_type": ["A", "AAAA"] },
          { "rule_set": "NetworkProcess", "invert": true }
        ],
        "server": "dns-fakeip",
        "rewrite_ttl": 1
      },
      // Clash 模式
      { "clash_mode": "Direct", "server": "dns-direct" },
      { "clash_mode": "Global", "server": "dns-proxy" },
      // 地理位置
      { "rule_set": "GeoSites@CN", "server": "dns-direct" },
      { "rule_set": "GeoSites@!CN", "server": "dns-proxy" },
      // CN IP 直接解析
      { "action": "evaluate", "server": "dns-direct" },
      { "match_response": true, "rule_set": "GeoIP@CN", "action": "respond" }
    ],
    "final": "dns-proxy",
    "reverse_mapping": true,
    "strategy": "prefer_ipv6"
  },
  "route": {
    "rules": [
      // DNS inbound
      { "inbound": "dns-in", "action": "hijack-dns" },
      // Direct Process
      { "rule_set": "NetworkProcess", "preferred_by": "BRIDGE", "outbound": "BRIDGE" },
      { "rule_set": "NetworkProcess", "outbound": "DIRECT" },
      // Tailscale
      { "preferred_by": "tailscale-ep", "outbound": "tailscale-ep" },
      // Direct Destination
      { "network": "icmp", "preferred_by": "BRIDGE", "outbound": "BRIDGE" },
      { "network": "icmp", "outbound": "DIRECT" },
      { "ip_is_private": true, "preferred_by": "BRIDGE", "outbound": "BRIDGE" },
      { "ip_is_private": true, "outbound": "DIRECT" },
      // DNS
      { "action": "sniff" },
      { "protocol": "dns", "action": "hijack-dns" },
      // Block DoT/DoH
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          { "process_name": "q", "invert": true },
          { "rule_set": ["GeoIP@CN", "GeoSites@CN"], "invert": true },
          {
            "type": "logical",
            "mode": "or",
            "rules": [
              { "network": "tcp", "port": 853 }, // DoT
              { "protocol": ["http", "tls"], "rule_set": "DoH" } // DoH
            ]
          }
        ],
        "action": "reject"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          { "process_name": "q", "invert": true },
          { "rule_set": ["GeoIP@CN", "GeoSites@CN"], "invert": true },
          {
            "type": "logical",
            "mode": "or",
            "rules": [
              { "network": "udp", "port": 853 }, // DoQ
              { "protocol": "quic", "rule_set": "DoH" } // DoH/3
            ]
          }
        ],
        "action": "reject",
        "method": "drop" // 静默防风暴
      },
      // Direct Protocol
      // { "protocol": "stun", "action": "reject" }, // 禁用 STUN
      { "protocol": ["bittorrent", "ntp", "stun"], "outbound": "DIRECT" },
      // Direct Domain
      {
        "rule_set": ["FakeIpBypass", "Private", "Direct", "GeoIP@CN", "GeoSites@CN"],
        "invert": true,
        "action": "sniff-override-destination"
      }
    ],
    "default_domain_resolver": "dns-direct"
  }
}
// vim: ft=jsonc
